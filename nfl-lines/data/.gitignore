backtest/strategies/s4-rest-spread.json
backtest/strategies/s5-division-under.json
backtest/strategies/s6-dome-over.json
backtest/strategies/s7-elo-two-leg-parlay.json
backtest/strategies/s8-elo-three-leg-parlay.json
backtest/strategies/s3-total-shrink.json
