12,"shortname":518,"title":519,"tickets":12,"twitter":520,"youtube":12,"rosterId":-1,"scheduleId":-1,"displayOpponentHistory":122,"short_title":12,"url":12},"CAM INST",0,"cameron-institute","cameron","Cameron Institute","CalCameronInst",{"abbreviation":522,"facebook":12,"gender":466,"global_sport_id":12,"global_sport_shortname":18,"global_sport_name_slug":522,"id":523,"instagram":12,"non_sport":7,"pinterest":12,"shortname":524,"title":525,"tickets":12,"twitter":12,"youtube":12,"rosterId":-1,"scheduleId":-1,"displayOpponentHistory":122,"short_title":12,"url":12},"deibj",74,"deib","DEIBJ",{"abbreviation":527,"facebook":12,"gender":195,"global_sport_id":528,"global_sport_shortname":529,"global_sport_name_slug":530,"id":531,"instagram":532,"non_sport":7,"pinterest":12,"shortname":529,"title":533,"tickets":12,"twitter":534,"youtube":12,"rosterId":-1,"scheduleId":-1,"displayOpponentHistory":122,"short_title":12,"url":12},"DANCE",39,"dance","dance-team",75,"caldanceteam","Dance Team","@caldanceteam",{"abbreviation":536,"facebook":12,"gender":195,"global_sport_id":537,"global_sport_shortname":538,"global_sport_name_slug":539,"id":540,"instagram":541,"non_sport":7,"pinterest":12,"shortname":538,"title":542,"tickets":12,"twitter":543,"youtube":12,"rosterId":-1,"scheduleId":-1,"displayOpponentHistory":122,"short_title":12,"url":12},"CHEER",38,"cheer","cheerleading",76,"calcheerteam","Cheerleading","@CalCheerleading",{"abbreviation":18,"facebook":12,"gender":466,"global_sport_id":516,"global_sport_shortname":18,"global_sport_name_slug":18,"id":545,"instagram":12,"non_sport":122,"pinterest":12,"shortname":18,"title":18,"tickets":546,"twitter":12,"youtube":12,"rosterId":-1,"scheduleId":-1,"displayOpponentHistory":122,"short_title":12,"url":12},77,"https:\u002F\u002Fcalbears.com\u002Fsports\u002F2024\u002F7\u002F31\u002Fcal-womens-basketball-tickets.aspx",{"abbreviation":548,"facebook":12,"gender":466,"global_sport_id":12,"global_sport_shortname":549,"global_sport_name_slug":550,"id":551,"instagram":12,"non_sport":7,"pinterest":12,"shortname":549,"title":552,"tickets":12,"twitter":12,"youtube":553,"rosterId":-1,"scheduleId":-1,"displayOpponentHistory":122,"short_title":12,"url":12},"ICF","icf","inside-cal-football",79,"Inside Cal Football","https:\u002F\u002Fwww.youtube.com\u002Fplaylist?list=PLwBgh0XaJW_CSApMGJd-Wev8DB1SeoY6e",{"stories":555,"preloadedStories":556,"paginationCursor":557,"basePageSize":558,"isLoadingMore":559,"isLoading":560,"moreToLoad":561,"storyContent":562,"storyGames":611,"isLoadingStoryGames":122,"storyGameLeaders":612,"isLoadingStoryGameLeaders":122,"storyGamesTeamsStats":614,"isLoadingStoryGamesTeamsStats":616,"isStoryContentUnsafeHtml":617,"storyNextGame":618,"isLoadingStoryNextGame":122,"storyContentLoading":619,"nextStory":620,"storySettings":621,"defaultSportTemplate":151,"preloadedTemplates":629},{},{},{},{},{},{},{},{"1339057035622804":563},{"applyStandardFormatting":7,"blocks":12,"isBlockBased":122,"contentId":564,"contentTitle":112,"contentDate":565,"contentUrl":8,"contentImageUrl":566,"content":567,"contentTemplate":151,"id":568,"title":112,"titleInRotator":7,"subHeadline":113,"teaser":569,"type":18,"byline":570,"appExclusive":122,"date":565,"sportDisplay":211,"sport":571,"sportShortname":208,"primaryImage":574,"imageSource":566,"imageFocalPoint":12,"imageAltText":116,"imageCaption":18,"video":576,"url":8,"redirectAbsoluteUrl":18,"links":578,"homepageFeedTemplate":18,"games":579,"galleryId":516,"galleryImages":580,"writer":12,"players":581,"globalSportMapName":208,"storyMetaDescription":12,"storyMetaOgDescription":12,"storyMetaKeywords":12,"storyMetaOgTitle":12,"imageCreditText":575,"alternateImage":12,"insideContentImage":12,"formattedDate":610,"gamePostStoryId":12,"isMediaOnStoryPage":7},"77390","2026-09-16T11:00:00","\u002Fimages\u002F2024\u002F12\u002F3\u002FFans__California_Memorial_Stadium_CAL_FB_Stanford_20241123_143047_CHayne.JPG","\u003Cbr>\r\nCal fans now know which nine Atlantic Coast Conference football teams the Bears will face next season after the ACC revealed its 2027 conference schedule Wednesday.\r\n\u003Cp dir=\"ltr\">Next season will mark the second one in which most ACC teams will play nine conference games. The Bears will meet Boston College, Florida State, Louisville and SMU at California Memorial Stadium.\u003C\u002Fp>\r\n\r\n\u003Cp dir=\"ltr\">Cal's conference road games will take place at Georgia Tech, Miami, Pitt, Stanford and Wake Forest. The matchup with the Yellow Jackets will be the teams' first as conference foes and will mean that the Bears have faced all the other 16 ACC football teams since Cal joined the conference in 2024.\u003C\u002Fp>\r\n\r\n\u003Cp dir=\"ltr\">Some notes about how Cal has fared against the four ACC teams coming to Berkeley in 2027:\u003C\u002Fp>\r\n\u003Cstrong>Boston College\u003C\u002Fstrong>\u003Cbr>\r\nThe series is tied 1-1, with the Bears earning a 28-24 win in Chestnut Hill last season. \u003Cdfn>\u003Ca href=\"\u002Fsports\u002Ffootball\u002Froster\u002Fjaron-keawe-sagapolutele\u002F27583\" rel=\"smarttag\" rev=\"27583\">Jaron-Keawe Sagapolutele's\u003C\u002Fa>\u003C\u002Fdfn> 51-yard touchdown pass to \u003Cdfn>\u003Ca href=\"\u002Fsports\u002Ffootball\u002Froster\u002Fmason-mini\u002F27571\" rel=\"smarttag\" rev=\"27571\">Mason Mini\u003C\u002Fa>\u003C\u002Fdfn> with 1:30 left was the game-winner.  Next season marks the Eagles' first visit to Memorial Stadium.\u003Cbr>\r\n\u003Cbr>\r\n\u003Cstrong>Florida State\u003C\u002Fstrong>\u003Cbr>\r\nThe Seminoles also will be making their first appearance in Berkeley. In the lone previous matchup between the teams, FSU pulled out a 14-9 victory in 2024.\r\n\u003Cp>\u003Cstrong>Louisville\u003C\u002Fstrong>\u003Cbr>\r\nThe Cardinals will join the Eagles and Seminoles as first-time visitors to Strawberry Canyon. Cal prevailed in the only meeting between the schools in a 29-26 overtime decision at Louisville last season. Sagapolutele's 3-yard TD pass to \u003Cdfn>\u003Ca href=\"\u002Fsports\u002Ffootball\u002Froster\u002Fjacob-de-jesus\u002F26293\" rel=\"smarttag\" rev=\"26293\">Jacob De Jesus\u003C\u002Fa>\u003C\u002Fdfn> on 4th-and-goal in the extra period gave the Bears the victory.\u003Cbr>\r\n\u003Cbr>\r\n\u003Cstrong>SMU\u003C\u002Fstrong>\u003Cbr>\r\nThe Mustangs lead the series 2-1, but the Bears grabbed a 38-35 win over SMU at California Memorial Stadium in the regular-season finale last year. Sagapolutele threw for 330 yards and four scores. The teams meet this season in Dallas on Oct. 24. \u003C\u002Fp>\r\n\r\n\u003Cp>The dates and times of next season's conference games will be announced later. Cal's three 2027 nonconference games are against Sacramento State (Aug. 28), at UCLA (Sept. 4) and against Old Dominion (Sept. 11).\u003C\u002Fp>\r\n",77390,"\u003Cp dir=\"ltr\">Three Teams Set To Make First Trip To Berkeley\u003C\u002Fp>\r\n\r\n\u003Cp dir=\"ltr\">\r\n","Cal Athletics",{"id":209,"title":211,"abbreviation":205,"shortTitle":211,"shortname":208,"facebook":206,"twitter":213,"gender":170,"pinterest":18,"instagram":210,"youtube":18,"globalSportShortname":208,"globalSportNameSlug":208,"tickets":212,"youtubePlaylistId":572,"globalSportId":207,"nonSport":122,"showAtVs":7,"gameSynonym":573},"PL98D1FA157B2A35BB","Games",{"caption":18,"creditText":575,"focalPoint":12,"url":566,"absoluteUrl":566,"altText":116,"title":12,"creditName":12},"Catharyn Hayne  \u002F KLC fotos",{"youtube":12,"archive":12,"metadata":577},{"title":12,"thumbnail":12},[],[],[],[582,592,601],{"rosterPlayerId":583,"rosterId":584,"playerId":585,"rpPositionShort":586,"rpJerseyNumber":587,"firstName":588,"lastName":589,"headshot":590,"sport":591},26293,2651,10395,"WR","21","Jacob","De Jesus","\u002Fimages\u002F2025\u002F7\u002F29\u002FJacob_De_Jesus_Cal____FB____25-0715_125801_Al_Sermeno.jpg",{"abbrev":205,"shortDisplay":211,"shortName":208,"globalSportId":207,"globalSportNameSlug":208,"globalSportGender":170,"id":209,"title":211},{"rosterPlayerId":