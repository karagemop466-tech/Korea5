12},"DANCE",39,"dance","dance-team",75,"caldanceteam","Dance Team","@caldanceteam",{"abbreviation":536,"facebook":12,"gender":195,"global_sport_id":537,"global_sport_shortname":538,"global_sport_name_slug":539,"id":540,"instagram":541,"non_sport":7,"pinterest":12,"shortname":538,"title":542,"tickets":12,"twitter":543,"youtube":12,"rosterId":-1,"scheduleId":-1,"displayOpponentHistory":122,"short_title":12,"url":12},"CHEER",38,"cheer","cheerleading",76,"calcheerteam","Cheerleading","@CalCheerleading",{"abbreviation":18,"facebook":12,"gender":466,"global_sport_id":516,"global_sport_shortname":18,"global_sport_name_slug":18,"id":545,"instagram":12,"non_sport":122,"pinterest":12,"shortname":18,"title":18,"tickets":546,"twitter":12,"youtube":12,"rosterId":-1,"scheduleId":-1,"displayOpponentHistory":122,"short_title":12,"url":12},77,"https:\u002F\u002Fcalbears.com\u002Fsports\u002F2024\u002F7\u002F31\u002Fcal-womens-basketball-tickets.aspx",{"abbreviation":548,"facebook":12,"gender":466,"global_sport_id":12,"global_sport_shortname":549,"global_sport_name_slug":550,"id":551,"instagram":12,"non_sport":7,"pinterest":12,"shortname":549,"title":552,"tickets":12,"twitter":12,"youtube":553,"rosterId":-1,"scheduleId":-1,"displayOpponentHistory":122,"short_title":12,"url":12},"ICF","icf","inside-cal-football",79,"Inside Cal Football","https:\u002F\u002Fwww.youtube.com\u002Fplaylist?list=PLwBgh0XaJW_CSApMGJd-Wev8DB1SeoY6e",{"stories":555,"preloadedStories":556,"paginationCursor":557,"basePageSize":558,"isLoadingMore":559,"isLoading":560,"moreToLoad":561,"storyContent":562,"storyGames":582,"isLoadingStoryGames":122,"storyGameLeaders":583,"isLoadingStoryGameLeaders":122,"storyGamesTeamsStats":585,"isLoadingStoryGamesTeamsStats":587,"isStoryContentUnsafeHtml":588,"storyNextGame":589,"isLoadingStoryNextGame":122,"storyContentLoading":590,"nextStory":591,"storySettings":592,"defaultSportTemplate":151,"preloadedTemplates":600},{},{},{},{},{},{},{},{"4490004003039780":563},{"applyStandardFormatting":7,"blocks":12,"isBlockBased":122,"contentId":564,"contentTitle":112,"contentDate":565,"contentUrl":8,"contentImageUrl":566,"content":567,"contentTemplate":151,"id":568,"title":112,"titleInRotator":7,"subHeadline":113,"teaser":113,"type":18,"byline":569,"appExclusive":122,"date":565,"sportDisplay":211,"sport":570,"sportShortname":208,"primaryImage":573,"imageSource":566,"imageFocalPoint":12,"imageAltText":116,"imageCaption":574,"video":575,"url":8,"redirectAbsoluteUrl":18,"links":577,"homepageFeedTemplate":18,"games":578,"galleryId":516,"galleryImages":579,"writer":12,"players":580,"globalSportMapName":208,"storyMetaDescription":12,"storyMetaOgDescription":12,"storyMetaKeywords":12,"storyMetaOgTitle":12,"imageCreditText":12,"alternateImage":12,"insideContentImage":12,"formattedDate":581,"gamePostStoryId":12,"isMediaOnStoryPage":7},"73988","2024-07-10T10:00:00","\u002Fimages\u002F2024\u002F7\u002F10\u002FUCLA-WEB-GFX__2_.png","The California and UCLA football teams have agreed to meet in nonconference games for four consecutive seasons from 2026-29 with each team hosting a pair of the four contests. Cal will welcome UCLA to California Memorial Stadium in Berkeley on Sept. 5, 2026 and Sept. 2, 2028, while the Golden Bears will travel to the Rose Bowl in Pasadena, on Sept. 4, 2027 and Sept. 15, 2029.\u003Cbr>\r\n\u003Cbr>\r\nThe nonconference contests will be the first ever between Cal and UCLA. The teams first met in 1933 and have played a total of 94 times, including at least one conference game every season for 91 consecutive campaigns from 1933-2023 while meeting twice each year from 1943-45. The Bruins lead the all-time series, 58-35-1, while Cal was a 33-7 winner in their most recent meeting in the 2023 regular-season finale for both teams at the Rose Bowl.\u003Cbr>\r\n\u003Cbr>\r\nCal (Atlantic Coast Conference) and UCLA (Big Ten) will play football in different conferences beginning in 2024 and are not scheduled to play against each other in either 2024 or 2025.\u003Cbr>\r\n\u003Cbr>\r\nCal has also moved a previously scheduled home game in 2026 against UNLV from Sept. 5 to later in the same season on Oct. 3, while a previously scheduled two-game series against Florida (at Florida – Sept. 19, 2026; at Cal – Sept. 4, 2027) has been canceled.\u003Cbr>\r\n\u003Cbr>\r\n\u003Ca href=\"https:\u002F\u002Fcalbears.evenue.net\u002Fevents\u002FF24ST\">Full-season ticket packages for the 2024 campaign are also on sale now\u003C\u002Fa> and guarantee the same seat at the best price for all seven of Cal's home games. For more ticket information, visit \u003Ca href=\"https:\u002F\u002Fcalbears.com\u002Fsports\u002F2022\u002F7\u002F11\u002Fcal-golden-bears-football-tickets.aspx\">CalBears.com\u003C\u002Fa>, call 800-GO-BEARS or email \u003Ca href=\"mailto:goldstandard@berkeley.edu\">goldstandard@berkeley.edu\u003C\u002Fa>.\u003Cbr>\r\n\u003Cbr>\r\nFans can also learn more about philanthropically supporting the Bears by participating in the \u003Ca href=\"https:\u002F\u002Fwww.calathleticsfund.com\u002Fcal-football-caliber\" target=\"_blank\">Cal Football Championship CALiber\u003C\u002Fa> program.\u003Cbr>\r\n \r\n\u003Ch2>\u003Cstrong>California Football Future Schedules\u003C\u002Fstrong>\u003C\u002Fh2>\r\n\u003Cstrong>2025\u003Cbr>\r\nDate – Opponent\u003C\u002Fstrong>\u003Cbr>\r\nAug. 30 – at Oregon State\u003Cbr>\r\n\u003Cstrong>\u003Cstrong>Sept. 13 – Minnesota\u003C\u002Fstrong>\u003C\u002Fstrong>\u003Cbr>\r\nSept. 20 – at San Diego State\u003Cbr>\r\n\u003Cstrong>TBA (ACC Home Games) – Duke, North Carolina, SMU, Virginia\u003C\u002Fstrong>\u003Cbr>\r\nTBA (ACC Road Games) – Boston College, Louisville, Stanford, Virginia Tech\u003Cbr>\r\n \u003Cbr>\r\n\u003Cstrong>2026\u003Cbr>\r\nDate – Opponent\u003C\u002Fstrong>\u003Cbr>\r\n\u003Cstrong>Sept. 5 – UCLA\u003C\u002Fstrong>\u003Cbr>\r\n\u003Cstrong>Oct. 3 – UNLV\u003C\u002Fstrong>\u003Cbr>\r\n\u003Cstrong>TBA (ACC Home Games) – Clemson, Stanford, Virginia Tech, Wake Forest\u003C\u002Fstrong>\u003Cbr>\r\nTBA (ACC Road Games) – North Carolina State, SMU, Syracuse, Virginia\u003Cbr>\r\n \u003Cbr>\r\n\u003Cstrong>2027\u003Cbr>\r\nDate – Opponent\u003C\u002Fstrong>\u003Cbr>\r\nSept. 4 – at UCLA\u003Cbr>\r\n\u003Cstrong>TBA (ACC Home Games) – Boston College, Florida State, Louisville, SMU\u003C\u002Fstrong>\u003Cbr>\r\nTBA (ACC Road Games) – Georgia Tech, Miami, Pittsburgh, Stanford\u003Cbr>\r\n \u003Cbr>\r\n\u003Cstrong>2028\u003Cbr>\r\nDate – Opponent\u003C\u002Fstrong>\u003Cbr>\r\n\u003Cstrong>Sept. 2 – UCLA\u003C\u002Fstrong>\u003Cbr>\r\nSept. 16 – at Minnesota\u003Cbr>\r\n\u003Cstrong>TBA (ACC Home Games) – Georgia Tech, North Carolina State, Pittsburgh, Stanford\u003C\u002Fstrong>\u003Cbr>\r\nTBA (ACC Road Games) – Florida State, Louisville, SMU, Wake Forest\u003Cbr>\r\n \u003Cbr>\r\n\u003Cstrong>2029\u003Cbr>\r\nDate – Opponent\u003C\u002Fstrong>\u003Cbr>\r\n\u003Cstrong>Sept. 1 – Wisconsin\u003C\u002Fstrong>\u003Cbr>\r\nSept. 8 – at Wyoming\u003Cbr>\r\nSept. 15 – at UCLA\u003Cbr>\r\n\u003Cstrong>TBA (ACC Home Games) – Duke, Miami, SMU, Syracuse\u003C\u002Fstrong>\u003Cbr>\r\nTBA (ACC Road Games) – Boston College, Clemson, North Carolina, Stanford\u003Cbr>\r\n \u003Cbr>\r\n\u003Cstrong>2030\u003Cbr>\r\nDate – Opponent\u003C\u002Fstrong>\u003Cbr>\r\nAug. 31 – at Wisconsin\u003Cbr>\r\n\u003Cstrong>TBA (ACC Home Games) – Clemson, North Carolina, Stanford, Virginia\u003C\u002Fstrong>\u003Cbr>\r\nTBA (ACC Road Games) – Duke, Georgia Tech, SMU, Virginia Tech\u003Cbr>\r\n\u003Cbr>\r\n\u003Cstrong>2032\u003Cbr>\r\nDate – Opponent\u003C\u002Fstrong>\u003Cbr>\r\n\u003Cstrong>Sept. 4 – Wyoming\u003C\u002Fstrong>\u003Cbr>\r\n ",73988,"Cal Athletics",{"id":209,"title":211,"abbreviation":205,"shortTitle":211,"shortname":208,"facebook":206,"twitter":213,"gender":170,"pinterest":18,"instagram":210,"youtube":18,"globalSportShortname":208,"globalSportNameSlug":208,"tickets":212,"youtubePlaylistId":571,"globalSportId":207,"nonSport":122,"showAtVs":7,