<div class="cmp-article-header" id="article-header-2ce1fe8f82" data-cmp-data-layer="{&#34;article-header-2ce1fe8f82&#34;:{&#34;@type&#34;:&#34;aem-nfl-base/components/blog/article-header&#34;}}">
 <p class="article-teaser__info">
     <span class="article-teaser__season">2026</span>
     
 </p>
 <div class="headline">

<div class="cmp-title" id="headline-4e5e38469b" data-cmp-data-layer="{&#34;headline-4e5e38469b&#34;:{&#34;@type&#34;:&#34;aem-nfl-base/components/content/headline&#34;,&#34;dc:title&#34;:&#34;2026 Kickoff Guide&#34;}}">
    <h1 class="cmp-title__text">
        2026 Kickoff Guide
    </h1>
</div>

    

</div>


 
     <span class="article-teaser__category">Football Communications</span>
 
     <span class="article-teaser__category">Kickoff Guide</span>
 

    <div class="cmp-article-header__date-share-wrapper">
        <div class="cmp-article-header__publication-date">
            <time datetime="Sep 09, 2026">
                Sep 09, 2026
            </time>
        </div>
        <!--/* TODO: Update button data-src to be new values of copyPath derived from page vs pdfPath */ -->
        <div class="button cmp-button--color-secondary">
            <button class="cmp-article-header__share cmp-button" tooltip="Copy to Clipboard" data-src="https://media.nfl.com/content/dam/communications/media/publications/2026%20Kickoff%20Guide.pdf">
                Share
                <i class="cmp-button__icon far fa-share-nodes" aria-hidden="true"></i>
            </button>
        </div>
