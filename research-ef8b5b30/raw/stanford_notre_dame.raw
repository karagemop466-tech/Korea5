ator:""}},videoWmtBaseUrl:"https://video.wmt.media/embed",leanstreamProxyBaseUrl:"https://us-central1-lyrical-amulet-150218.cloudfunctions.net/wmt-leanstream-proxy-v2",integrations:{tintup:{dataId:"",dataPersonalizationId:""},onefield:{siteId:""}},sportScripts:[{sportSlug:"mens-basketball",url:"https://chat.satis.fi/popup/embedder?popupId=18485",props:{attrs:{id:"satisfiScript"}}},{sportSlug:"football",url:"https://chat.satis.fi/popup/embedder?popupId=18484",props:{attrs:{id:"satisfiScript"}}},{sportSlug:"",url:"https://chat.satis.fi/popup/embedder?popupId=18109",props:{attrs:{id:"satisfiScript"}}}]},sentry:{dsn:"https://d12b8b96651fd96f79d2cc6f7e326066@sentry.wmt.dev/261",release:"d2e675da7509999790bd5088343679989a9fb79b",environment:"production",sampleRate:.5,tracesSampleRate:.01,replaysSessionSampleRate:.3,replaysOnErrorSampleRate:1,profilesSampleRate:0},"nuxt-scripts":{version:"",defaultScriptOptions:{trigger:"onNuxtReady"}}},app:{baseURL:"/",buildId:"91171b1c-2b07-4d96-890d-cf9be38c3311",buildAssetsDir:"/_nuxt/",cdnURL:""}}</script><script type="application/ld+json" data-nuxt-schema-org="true" data-hid="schema-org-graph">{"@context":"https://schema.org","@graph":[{"@id":"https://gostanford.com/#website","@type":"WebSite","description":"The Official Athletic Site of Stanford University, partner of WMT Digital. The most comprehensive coverage of Stanford Athletics with rosters, schedules, scores, highlights, game recaps, and more!","name":"Stanford Cardinal - Official Athletics Website","url":"/","potentialAction":[{"@type":"SearchAction","target":[{"@type":"EntryPoint","urlTemplate":"/search?s={search_term_string}"}],"query-input":"required name=search_term_string"}]},{"@id":"https://gostanford.com/news/2026/05/20/two-dates-added-to-notre-dame-rivalry#webpage","@type":"WebPage","name":"Two Dates Added to Notre Dame Rivalry","url":"https://gostanford.com/news/2026/05/20/two-dates-added-to-notre-dame-rivalry","isPartOf":{"@id":"https://gostanford.com/#website"},"potentialAction":[{"@type":"ReadAction","target":["https://gostanford.com/news/2026/05/20/two-dates-added-to-notre-dame-rivalry"]}]},{"@id":"https://gostanford.com/news/2026/05/20/two-dates-added-to-notre-dame-rivalry#/schema/news-article/1","@type":"NewsArticle","articleBody":"STANFORD, Calif. &mdash; Announced on Wednesday morning, Stanford football and Notre Dame officially agreed to a two-year extension of their annual rivalry game, with dates set for 2027 and 2028.\nThe battle for The Legends Trophy will next return to The Farm on Nov. 27, 2027, before Stanford heads out to Notre Dame on Oct. 14, 2028.\nBoth historic programs have met annually since 1997, with only one interruption due to the COVID-19 pandemic in 2020. The upcoming installment of Stanford-Notre Dame in 2026 will be the 40th game played between the Cardinal and Fighting Irish.\nThis year&rsquo;s game at Notre Dame Stadium is set for Oct. 10 with a 12:30 p.m. PT kickoff on NBC.","datePublished":"2026-05-20T16:00:00.000000Z","description":"Stanford, Notre Dame announce games in 2027 and 2028","headline":"Two Dates Added to Notre Dame Rivalry","inLanguage":"en_US","wordCount":116,"about":{},"author":{"@type":"Person","name":"Brian Brownfield"},"image":{"@id":"https://gostanford.com/#/schema/image/1"},"video":[]},{"@id":"https://gostanford.com/#/schema/image/1","@type":"ImageObject","contentUrl":"https://gostanford.com/imgproxy/dn6PVg7eAtdgs0OnwVHHeWyPEPFQw4EWkFTFXkynKuE/rs:fit:1980:0:0:0/g:ce:0:0/q:90/aHR0cHM6Ly9zdG9yYWdlLmdvb2dsZWFwaXMuY29tL3N0YW5mb3JkLXByb2QvMjAyNi8wNS8xOS9GQ25QZUdCNDZINWxYU3RibGljNlJ1dmRWbWhmT21lRk9Dd2V5dUZkLmpwZw.jpg","url":"https://gostanford.com/imgproxy/dn6PVg7eAtdgs0OnwVHHeWyPEPFQw4EWkFTFXkynKuE/rs:fit:1980:0:0:0/g:ce:0:0/q:90/aHR0cHM6Ly9zdG9yYWdlLmdvb2dsZWFwaXMuY29tL3N0YW5mb3JkLXByb2QvMjAyNi8wNS8xOS9GQ25QZUdCNDZINWxYU3RibGljNlJ1dmRWbWhmT21lRk9Dd2V5dUZkLmpwZw.jpg"}]}</script><script type="application/json" data-nuxt-data="nuxt-app" data-ssr="true" id="__NUXT_DATA__">[["Shall