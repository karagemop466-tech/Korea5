" aria-controls="header-schedule-ticker"><span class="sr-only">Open Schedule Ticker</span><svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-hidden="true" role="img" class="iconify iconify--octicon icon header-calendar-button__icon header-calendar-button__icon--close" style="" width="1em" height="1em" viewBox="0 0 16 16"><path fill="currentColor" d="M4.75 0a.75.75 0 0 1 .75.75V2h5V.75a.75.75 0 0 1 1.5 0V2h1.25c.966 0 1.75.784 1.75 1.75v10.5A1.75 1.75 0 0 1 13.25 16H2.75A1.75 1.75 0 0 1 1 14.25V3.75C1 2.784 1.784 2 2.75 2H4V.75A.75.75 0 0 1 4.75 0M2.5 7.5v6.75c0 .138.112.25.25.25h10.5a.25.25 0 0 0 .25-.25V7.5Zm10.75-4H2.75a.25.25 0 0 0-.25.25V6h11V3.75a.25.25 0 0 0-.25-.25"/></svg></button></div><div class="header-search header__control"><div class="header-search__box"><div></div></div><span></span></div><span></span><!----><div class="header__burger-wrapper"><button class="header-burger" tabindex="0" aria-label="Open Main Menu" aria-expanded="false" aria-controls="main-menu"><!--[--><!--]--><span class="sr-only"><!--[-->Open Main Menu<!--]--></span><svg class="header-burger__icon" viewBox="0 0 100 100"><path class="header-burger__line header-burger__line--top" d="m 30,33 h 40 c 3.722839,0 7.5,3.126468 7.5,8.578427 0,5.451959 -2.727029,8.421573 -7.5,8.421573 h -20"></path><path class="header-burger__line header-burger__line--middle" d="m 30,50 h 40"></path><path class="header-burger__line header-burger__line--bottom" d="m 70,67 h -40 c 0,0 -7.5,-0.802118 -7.5,-8.365747 0,-7.563629 7.5,-8.634253 7.5,-8.634253 h 20"></path></svg></button></div><!----></div><!--]--></div></header></div><!----><div id="main-content" class=""><!--[--><!--[--><div><div class="article-page" is-recap-page="false"><div class="article-page__content-wrapper"><section class="article-head" data-v-967f060f><div class="article-head__image-wrapper" data-v-967f060f><div class="article-featured-image" data-v-967f060f><img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="FB action photo from Notre Dame used 5-20-26" title="Two Dates Added to Notre Dame Rivalry" class="image image--default article-featured-image__media article-featured-image__media--desktop article-featured-image__alignment-center v-lazy-image" loading="lazy" data-v-122f871d><img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="FB action photo from Notre Dame used 5-20-26" title="Two Dates Added to Notre Dame Rivalry" class="image image--default article-featured-image__media article-featured-image__media--mobile article-featured-image__alignment-center v-lazy-image" loading="lazy" data-v-122f871d></div><span class="article-head__image-credit" data-v-967f060f>Karen Hickey / ISI Photos</span></div><div class="container article-head__container" data-v-967f060f><!--[--><!----><!----><div class="article-head__inner" data-v-967f060f><div class="article-head__meta" data-v-967f060f><span class="sport-links article-head__sport" data-v-967f060f><!--[--><!--[--><a href="/sports/football" class="sport-links__link">Football</a><!--]--><!--]--></span><time class="article-head__date" data-v-967f060f>May 20, 2026</time><!----></div><h1 class="article-head__title" data-v-967f060f>Two Dates Added to Notre Dame Rivalry</h1><p class="article-head__description" data-v-967f060f>Stanford, Notre Dame announce games in 2027 and 2028</p><!----><div class="article-head__share" data-v-967f060f><span data-v-967f060f> Share </span><div class="share" data-v-967f060f><a href="#" class="share__item"><span class="sr-only">Twitter</span><svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-hidden="true" role="img" class="iconify iconify--line-md icon share__icon" style="font-size:16px;" width="1em" height="1em" viewBox="0 0 24 24"><path fill="currentColor" d="M1 2h2.5l15 20h-2.5ZM5.5 2h2.5l15 20h-2.5ZM3 2h5v2h-5ZM16 20h5v2h-5ZM18.5 2h3.5l-17 20h-3.5Z"><animate fill="freeze" attributeName="d" dur="0.8s" keyTimes="0;0.3;0.5;1" values="M8.5 2h2.5l0 0h-2.5ZM13 2h2.5l0 0h-2.5ZM10.5 2h5v0h-5ZM8.5 2h5v0h-5ZM10 2h3.5l0 0h-3.5Z;M8.5 2h2.5l0 20h-2.5ZM13 2h2.5l0 20h-2.5ZM10.5 2h5v2h-5ZM8.5 20h5v2h-5ZM10 2h3.5l0 20h-3.5Z;M8.5 2h2.5l0 20h-2.5ZM13 2h2.5l0 20h-2.5ZM10.5 2h5v2h-5ZM8.5 20h5v2h-5ZM10 2h3.5l0 20h-3.5Z;M1 2h2.5l15 20h-2.5ZM5.5 2h2.5l15 20h-2.5ZM3 2h5v2h-5ZM16 20h5v2h-5ZM18.5 2h3.5l-17 20h-3.5Z"/></path></svg></a><a href="#" class="share__item"><span class="sr-only">Facebook</span><svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-hidden="true" role="img" class="iconify iconify--gg icon share__icon" style="font-size:16px;" width="1em" height="1em" viewBox="0 0 24 24"><path fill="currentColor" d="M9.198 21.5h4v-8.01h3.604l.396-3.98h-4V7.5a1 1 0 0 1 1-1h3v-4h-3a5 5 0 0 0-5 5v2.01h-2l-.396 3.98h2.396z"/></svg></a><a href="#" class="share__item"><span class="sr-only">Email</span><svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-hidden="true" role="img" class="iconify iconify--ic icon share__icon" style="font-size:16px;" width="1em" height="1em" viewBox="0 0 24 24"><path fill="currentColor" d="M22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2zm-2 0l-8 5l-8-5zm0 12H4V8l8 5l8-5z"/></svg></a></div></div></div><!--]--></div></section><!----><!--[--><div name="articleBeforeContent"></div><!--]--><!----><!--[--><div class="content-blocks content-blocks--article article-page__content-blocks"><!--[--><!--[--><!--[--><!----><!--]--><!--[--><section class="text-content"><!--[--><div class="container container--small text-content__container"><!--[--><div class="embed-html"><p><strong>STANFORD, Calif. &mdash; </strong>Announced on Wednesday morning, Stanford football and Notre Dame officially agreed to a two-year extension of their annual rivalry game, with dates set for 2027 and 2028.</p>
<p>The battle for The Legends Trophy will next return to The Farm on Nov. 27, 2027, before Stanford heads out to Notre Dame on Oct. 14, 2028.</p>
<p>Both historic programs have met annually since 1997, with only one interruption due to the COVID-19 pandemic in 2020. The upcoming installment of Stanford-Notre Dame in 2026 will be the 40<sup>th</sup> game played between the Cardinal and Fighting Irish.</p>
<p>This year&rsquo;s game at Notre Dame Stadium is set for Oct. 10 with a 12:30 p.m. PT kickoff on NBC.</p></div><!--]--></div><!--]--></section><!--]--><!--[--><!--[--><!----><!--]--><!--]--><!--]--><!--]--></div><!--]--><div class="container article-page__footer"><!--[--><!--]--></div><!--[--><div name="articleAfterContent"></div><!--]--><!----></div></div></div><!--]--><!--]--></div><footer class="footer" data-v-76bef933><div class="content-blocks content-blocks--default" data-v-76bef933><!--[--><!--[--><!--[--><!----><!--]--><!--[--><div class="sponsors" style="background-color:#9b1919;"><div class="sponsors__container"><!--[--><div class="sponsors-row sponsors-row--centered sponsors__row" style=""><div class="sponsors-row__wrapper"><!--[--><div class="sponsors-item sponsors-row__item" style=""><a href="https://www.coca-cola.com/" target="_blank" class="sponsors-item__link"><img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="coca-cola-logo-CibyXTuW" class="image image--default sponsors-item__logo v-lazy-image" loading="lazy" data-v-122f871d><span class="sr-only"> Opens in a new window </span></a></div><div class="sponsors-item sponsors-row__item" style=""><a href="https://www.sfcu.org/" target="_blank" class="sponsors-item__link"><img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="stanford-logo-CoqOYBOb" class="image image--default sponsors-item__logo v-lazy-image" loading="lazy" data-v-122f871d><span class="sr-only"> Opens in a new window </span></a></div><div class="sponsors-item sponsors-row__item" style=""><a href="https://stanfordhealthcare.org/discover/advancing-knowledge.html?cid=n/a%7Cdis%7Csathletics&amp;adinfo=%7Csponsored%7Clogo%7C" target="_blank" class="sponsors-item__link"><img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="stanford-medicine-logo-DAn3ewnT" class="image image--default sponsors-item__logo v-lazy-image" load