<script>
(function(window, undefined) {
  function addCookieNavToFooter() {
    var footerNav = document.querySelector('#playerFooter .footer-links ul, #theFooter .footer-nav ul');
    var footerLink = footerNav.querySelector('a[href="#cookiePrefs"]');
    if (!footerLink) {
      console.log('Failed to find cookie prefs link in footer.')
      return;
    }
    var span = footerLink.querySelector('span');
    span.remove();
    footerLink.href = 'javascript:void(0)';
    footerLink.className = 'ot-sdk-show-settings';  
    footerLink.id = 'teconsent';  
  }

  if (document.readyState !== 'loaded') {
    window.addEventListener('DOMContentLoaded', addCookieNavToFooter);
  } else {
    addCookieNavToFooter();
  }
})(window.self);
</script>
