/* Remove extra top margin on title when no featured image is set */
#sc-content-area .content-header.template-image_above:not(:has(img)) .feature-info h1 { margin-top: 0; }

/* Allow google ads to be aligned properly */
[data-google-query-id], [data-google-query-id] > div {
  display: flex;
  justify-self: center;
}
/* Content area ad margin */
div[id^="div-gpt-ad-content"] {
  margin-top: 1rem;
  margin-bottom: 1.5rem;
}

/* Center event images */
#event_info + .event_img { display: block; margin-left: auto; margin-right: auto; }

/* Do not display bakery placeholders */
.wpb_single_image:has(.vc_img-placeholder) { display: none; }

/* Do not display author on FCC Applications category list */
body.category-fcc-applications .sc-sidebar-wrapper .sc-content .sc-author { display: none; }

