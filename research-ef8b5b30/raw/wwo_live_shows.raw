(function () {
	var NAME = 'sc_form_token';

	function readCookie() {
		var match = document.cookie.match(/(?:^|;\s*)sc_form_token=([^;]*)/);
		return match ? decodeURIComponent(match[1]) : '';
	}

	function mintToken() {
		var hex = '';
		if (window.crypto && window.crypto.getRandomValues) {
			var bytes = new Uint8Array(32);
			window.crypto.getRandomValues(bytes);
			for (var i = 0; i < bytes.length; i++) hex += ('0' + bytes[i].toString(16)).slice(-2);
			return hex;
		}
		while (hex.length < 64) hex += Math.floor(Math.random() * 16).toString(16);
		return hex;
	}

	/* The token the cookie holds, minting and storing one when it holds none. Returns
	   '' when the cookie can't be written - a browser refusing cookies, or an older
	   httponly sc_form_token still in place, which document.cookie may not overwrite.
	   Either way the server-rendered field value is left exactly as it is. */
	function currentToken() {
		var token = readCookie();
		if (token) return token;

		token = mintToken();
		var cookie = NAME + '=' + token + ';path=/;max-age=3600;samesite=Strict';
		if (location.protocol === 'https:') cookie += ';secure';
		document.cookie = cookie;

		return readCookie() === token ? token : '';
	}

	function syncFields(scope) {
		var fields = (scope || document).querySelectorAll('input[name="sc_form_token"]');
		// No gated form in scope, so no reason to hand this visitor a cookie.
		if (!fields.length) return;

		var token = currentToken();
		if (!token) return;
		for (var i = 0; i < fields.length; i++) fields[i].value = token;
	}

	/* Capture phase, so the value is in place before the handlers that read the form
	   back out - the comment and activity-stream forms serialize themselves and post
	   over AJAX from their own submit handlers. */
	document.addEventListener('submit', function (e) { syncFields(e.target); }, true);

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', function () { syncFields(); });
	} else {
		syncFields();
	}
})();
</script><script type="speculationrules">
