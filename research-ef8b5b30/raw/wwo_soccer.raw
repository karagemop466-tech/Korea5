<script>
  /**
   * Injected mobile leaderboard, appears above page content.
   */
  (function(window, undefined) {
    function injectSlots() {
      var main = document.querySelector('body > main > #sc-content-area');
      if (!main) return;

      var div = document.createElement('div');
      div.id='div-gpt-ad-mobile-leaderboard-top';
      div.className='gpt-slot';
      main.prepend(div);

      googletag.cmd.push(function() {
        window.GPT_SITE_SLOTS = window.GPT_SITE_SLOTS || {};

        // Do not call if slot is hidden
        if (!div || !div.offsetParent) return;

        var sizeMap = googletag.sizeMapping()
          .addSize([780,0], [])
          .addSize([0,0], [[320, 50], [300, 50]])
          .build();

        window.GPT_SITE_SLOTS[div.id] = googletag.defineSlot(
          GPT_SITE_ID,
          [[728, 90], [970, 90], [970, 250]],
          div.id
        )
          .addService(googletag.pubads())
          .defineSizeMapping(sizeMap)
          .setCollapseEmptyDiv(true, false)
          .setTargeting("pos", "mobile-top")
        ;

        googletag.display(div.id);
      });
    }
    if (window.self.document.readyState !== 'loading') {
      injectSlots();
    } else {
      window.self.document.addEventListener('DOMContentLoaded', injectSlots);
    }
  })(window.self);
</script>
