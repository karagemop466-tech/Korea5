  line-height: 1.5;
  text-align: center;
  margin: 0 auto;
  padding: 1.5em 1.5em;
  position: relative;
  width: 100vw;
  left: 50%;
  right: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
  z-index: 999999;
}
#ot-footer-msg .inner {
  all: unset;
  magin: 0 auto;
  max-width: 790px;
}
#ot-footer-msg a {
  all: unset;
  cursor: pointer;
  color: #ddd;
}
#ot-footer-msg a:hover {
  color: #fff;
}
#ot-footer-msg a::before {
  content: "?";
  margin-right: 0.75em;
  vertical-align: middle;
}

#playerFooter .ot-sdk-show-settings::before,
#theFooter .ot-sdk-show-settings::before {
  content: "";
